<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Aucune barre d'action : l'interface est celle de l'espace, pas celle
         d'Android. Le fond est celui de l'application, posé avant le premier
         rendu pour qu'aucune fenêtre blanche n'apparaisse. -->
    <style name="Theme.Nemesis" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/nemesis_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>
</resources>
